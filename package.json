{
	"name": "brandojs",
	"version": "1.1.6",
	"description": "Automatically change CSS backgrounds on any DOM element in a random or sequential order. Includes a React component.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"engines": {
		"node": "24.x"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "concurrently \"vite --config vite.demo.config.ts\" \"typedoc --watch\"",
		"build": "npm run test:coverage && npm run build-coverage-badge && npm run build:lib && npm run build:demo && npm run docs",
		"build:lib": "vite build && tsc -p tsconfig.build.json",
		"build:demo": "vite build --config vite.demo.config.ts",
		"build-coverage-badge": "coverage-badger -r ./public/coverage/clover.xml -d ./public/coverage/",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"preview": "vite preview --config vite.demo.config.ts",
		"docs": "typedoc",
		"docs:watch": "typedoc --watch",
		"preversion": "git checkout master && git pull && npm ci",
		"version": "npm run build && git add -A",
		"postpublish": "git push && git push --tags"
	},
	"peerDependencies": {
		"react": ">=17",
		"react-dom": ">=17"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"details": {
		"stylizedName": "bRando",
		"subtitle": "Website background randomizer",
		"nickName": "yak"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/yak-was-here/brandojs.git"
	},
	"keywords": [
		"CSS",
		"background randomizer",
		"background changer",
		"background property",
		"background-image",
		"background-color",
		"background rotator",
		"color changer",
		"randomizer",
		"random",
		"sequential",
		"javascript",
		"typescript",
		"react",
		"react component"
	],
	"author": "yak <yak@isaacyakl.com> (https://www.isaacyakl.com/)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/yak-was-here/brandojs/issues"
	},
	"homepage": "https://brandojs.isaacyakl.com",
	"devDependencies": {
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@types/marked": "5.0.2",
		"@types/node": "24.13.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.3",
		"@vitest/coverage-v8": "^4.1.9",
		"concurrently": "10.0.3",
		"coverage-badger": "1.0.1",
		"jsdom": "29.1.1",
		"marked": "18.0.5",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"typedoc": "0.28.19",
		"typedoc-plugin-extras": "4.0.1",
		"typescript": "6.0.3",
		"vite": "8.1.0",
		"vitest": "^4.1.9"
	}
}
