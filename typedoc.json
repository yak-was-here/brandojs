{
	"$schema": "https://typedoc.org/schema.json",
	"plugin": ["typedoc-plugin-extras"],
	"tsconfig": "./tsconfig.docs.json",
	"entryPoints": ["./src/docs/index.ts"],
	"entryPointStrategy": "resolve",
	"out": "public/docs/",
	"name": "bRando.js",
	"readme": "none",
	"sidebarLinks": {
		"Readme": "https://github.com/yak-was-here/brandojs",
		"Demo": "https://brandojs.isaacyakl.com",
		"Usage": "https://brandojs.isaacyakl.com/#usage",
		"Coverage": "https://brandojs.isaacyakl.com/coverage/lcov-report/"
	},
	"includeVersion": true,
	"searchInComments": true,
	"titleLink": "https://brandojs.isaacyakl.com",
	"exclude": ["**/src/readme/**", "**/*.test.*", "**/test-setup.*", "**/node_modules/**"]
}
